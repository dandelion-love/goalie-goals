{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$(git rev-parse --show-toplevel)\"; git -C \"$r\" submodule update --init --depth 1 .gtd/kit >/dev/null 2>&1 || true; g=\"$r/.gtd/kit/tools/agent_guard.py\"; [ -f \"$g\" ] && python3 \"$g\" --codex-hook || true"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/privacy_guard.py\" --session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$(git rev-parse --show-toplevel)/.gtd/kit/tools/agent_guard.py\"; [ -f \"$g\" ] && python3 \"$g\" --codex-hook || true"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/privacy_guard.py\" --codex-hook"
          }
        ]
      }
    ]
  }
}
