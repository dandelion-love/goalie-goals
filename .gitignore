# Secrets and local config: never committed (see the public-repo-privacy skill)
.env
.env.*
!.env.example
*.local.*
!/.gtd/BOARD.local.md
.private/
private/

# Terraform: state, plans and variable values name the deployment (and state can hold
# secrets). Commit *.tf, .terraform.lock.hcl and *.tfvars.example only.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Data and media from real use
data/
exports/
*.sqlite
*.sqlite3
*.db

# Tooling
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/
coverage/
.DS_Store
Thumbs.db
.claude/settings.local.json
.playwright-mcp/
.tmp*/

# Terraform: state, variables and plans hold identifiers; never committed
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
.terraform.tfstate.lock.info
crash.log
