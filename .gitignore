# Secrets and local config: never committed (see the public-repo-privacy skill)
.env
.env.*
!.env.example
*.local.*
!/.gtd/BOARD.local.md
.private/
private/

# Data and media from real use
data/
exports/
*.sqlite
*.sqlite3
*.db

# Tooling
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/
coverage/
.DS_Store
Thumbs.db
.claude/settings.local.json
.playwright-mcp/
.tmp*/

# Terraform: state, variables and plans hold identifiers; never committed
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
.terraform.tfstate.lock.info
crash.log
