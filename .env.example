# Copy to .env.local (gitignored) for local runs. Placeholders and the demo cast only.

# Local development: sign test identity headers instead of the sign-in proxy.
# Refused when NODE_ENV=production.
GOALIE_DEV_MOCK_IDENTITY=1
GOALIE_DEV_AS=kai@example.com
GOALIE_ROLES=kai@example.com=keeper;sam@example.com=parent

# Deployed only: the proxy's signed-header audience. Never commit the real value.
# IAP_AUDIENCE=<audience>
